# Google Gemini API key (free tier, no credit card): https://aistudio.google.com/apikey
# Leave empty to run Teachback in demo mode with built-in mock quizzes and heuristic grading.
GEMINI_API_KEY=

# Gemini model to use. Check https://ai.google.dev/gemini-api/docs/models for the current Flash-tier name.
GEMINI_MODEL=gemini-3.6-flash

# Secret used to HMAC-sign quiz tokens (keeps the grading rubric off the client).
# Any long random string. A dev-only fallback is used if empty.
QUIZ_TOKEN_SECRET=
